# AdPulse environment variables: NAMES ONLY, never real values.
# `make secrets` (scripts/gen_secrets.sh) copies this into .env (mode 600):
#   - GENERATE  -> replaced with a random value (openssl rand -hex 24)
#   - empty     -> left empty; you fill it in yourself, in your own editor
# Existing values in .env are never overwritten.

# --- PostgreSQL per environment: superuser (image init), app user (owns DB adpulse),
#     monitor user (postgres_exporter, pg_monitor role)
STAGING_DB_ADMIN_PASSWORD=GENERATE
STAGING_DB_APP_PASSWORD=GENERATE
STAGING_DB_MONITOR_PASSWORD=GENERATE
PROD_DB_ADMIN_PASSWORD=GENERATE
PROD_DB_APP_PASSWORD=GENERATE
PROD_DB_MONITOR_PASSWORD=GENERATE
AWS_PROD_DB_ADMIN_PASSWORD=GENERATE
AWS_PROD_DB_APP_PASSWORD=GENERATE
AWS_PROD_DB_MONITOR_PASSWORD=GENERATE

# --- Redis requirepass, per environment
STAGING_REDIS_PASSWORD=GENERATE
PROD_REDIS_PASSWORD=GENERATE
AWS_PROD_REDIS_PASSWORD=GENERATE

# --- Chaos HTTP endpoints (staging only), sent as header X-Chaos-Token
CHAOS_TOKEN=GENERATE

# --- Grafana
GRAFANA_ADMIN_PASSWORD=GENERATE
# Service-account token for healer annotations; created automatically in Phase 8
GRAFANA_SA_TOKEN=

# --- Optional Discord/Slack webhook for alerts (Phase 7, Q4). Paste it here yourself.
ALERT_WEBHOOK_URL=
