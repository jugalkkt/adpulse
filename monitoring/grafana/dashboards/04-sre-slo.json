{
  "uid": "adpulse-slo",
  "title": "AdPulse SRE / SLO",
  "description": "Service level objectives, error budget remaining and burn rates.",
  "tags": [
    "adpulse"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "staging,prod,aws-prod",
        "current": {
          "text": "staging",
          "value": "staging"
        },
        "options": [
          {
            "text": "staging",
            "value": "staging",
            "selected": true
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          },
          {
            "text": "aws-prod",
            "value": "aws-prod",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#199e70",
        "name": "Healer actions",
        "target": {
          "type": "tags",
          "tags": [
            "heal"
          ],
          "limit": 100,
          "matchAny": false
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "name": "Firing alerts",
        "expr": "ALERTS{alertstate=\"firing\", env=~\"$env|host\"}",
        "step": "15s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{env}} {{severity}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "adpulse"
      ],
      "asDropdown": true,
      "title": "AdPulse"
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**SLOs for `/v1/ad`** - availability: 99.5% non-5xx (budget 0.5%); latency: 95% of requests under 150ms (budget 5%). Budget remaining is computed over the last 6h (demo window; docs/DECISIONS.md D036). Burn rate 1 = spending the budget exactly on schedule; the fast-burn alert fires at 14.4."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Availability (6h)",
      "description": "Target 99.5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - env:slo_availability_errors:ratio_rate6h{env=\"$env\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#d03b3b"
              },
              {
                "value": 0.995,
                "color": "#0ca30c"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2
    },
    {
