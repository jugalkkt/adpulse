{
  "uid": "adpulse-infrastructure",
  "title": "AdPulse Infrastructure",
  "description": "Host CPU, memory and disk; every AdPulse container against its limits.",
  "tags": [
    "adpulse"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "staging,prod,aws-prod",
        "current": {
          "text": "staging",
          "value": "staging"
        },
        "options": [
          {
            "text": "staging",
            "value": "staging",
            "selected": true
          },
          {
            "text": "prod",
            "value": "prod",
            "selected": false
          },
          {
            "text": "aws-prod",
            "value": "aws-prod",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#199e70",
        "name": "Healer actions",
        "target": {
          "type": "tags",
          "tags": [
            "heal"
          ],
          "limit": 100,
          "matchAny": false
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "name": "Firing alerts",
        "expr": "ALERTS{alertstate=\"firing\", env=~\"$env|host\"}",
        "step": "15s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{env}} {{severity}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "adpulse"
      ],
      "asDropdown": true,
      "title": "AdPulse"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Host CPU busy",
      "description": "HostHighCPU fires above 85% for 1m.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\", mode=\"idle\"}[1m]))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#0ca30c"
              },
              {
                "value": 0.7,
                "color": "#fab219"
              },
              {
                "value": 0.85,
                "color": "#d03b3b"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Host memory used",
      "description": "",
