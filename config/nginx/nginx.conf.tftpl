# nginx for AdPulse env "${env}". Rendered by Terraform (templatefile) and
# uploaded into the conf volume. Runs as the unprivileged nginx user (uid 101)
# on a read-only root filesystem; everything writable lives in /tmp (tmpfs).
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    server_tokens off;

    # Docker's embedded DNS. valid=5s + a variable in proxy_pass makes nginx
    # re-resolve api-${env}, so new or replaced replicas are picked up.
    resolver 127.0.0.11 valid=5s ipv6=off;

    # Keep the caller's X-Request-ID, or use nginx's own request id.
    map $http_x_request_id $req_id {
        default $http_x_request_id;
        ""      $request_id;
    }

    log_format json escape=json '{"ts":"$time_iso8601","env":"${env}","request_id":"$req_id",'
                                '"remote":"$remote_addr","method":"$request_method","uri":"$request_uri",'
                                '"status":$status,"request_time_s":$request_time,"bytes":$body_bytes_sent,'
                                '"upstream":"$upstream_addr","upstream_status":"$upstream_status",'
                                '"upstream_time_s":"$upstream_response_time"}';
    access_log /dev/stdout json;

    server {
        listen 8080;

        # nginx's own liveness; does not depend on the API.
        location = /nginx-health {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        # Internal-only endpoints are never exposed through the load balancer.
        location = /metrics { return 404; }
        location ^~ /admin/ { return 404; }

        location / {
            set $upstream http://api-${env}:8000;
            proxy_pass $upstream;

            proxy_set_header Host              $host;
            proxy_set_header X-Request-ID      $req_id;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            add_header X-Request-ID $req_id always;

            # Connects on a Docker network take <1 ms; a dead replica IP (removed
            # during a rolling deploy) should fail over fast, not after 2s.
            proxy_connect_timeout 500ms;
            proxy_send_timeout    2s;
            proxy_read_timeout    2s;
            proxy_next_upstream error timeout http_502 http_503;
            proxy_next_upstream_tries 2;
        }
    }
}
